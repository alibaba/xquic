+static void imquic_demo_moq_abort_relayed_fetches(imquic_demo_moq_publisher *pub) {
+	if(pub == NULL || pub->fetches_by_id == NULL)
+		return;
+	GList *pending = g_hash_table_get_values(pub->fetches_by_id);
+	g_hash_table_remove_all(pub->fetches_by_id);
+	GList *temp = pending;
+	while(temp) {
+		imquic_demo_moq_subscription *s = temp->data;
+		temp = temp->next;
+		if(s == NULL || s->sub == NULL || s->sub->conn == NULL)
+			continue;
+		s->relayed_fetch = FALSE;
+		imquic_demo_moq_subscriber *downstream = s->sub;
+		uint64_t downstream_request_id = s->request_id;
+		if(s->active) {
+			int ret = imquic_moq_end_fetch(
+				downstream->conn, downstream_request_id);
+			IMQUIC_LOG(IMQUIC_LOG_INFO,
+				"interop_fetch_abort|phase:after-ok|request_id:%"SCNu64
+				"|ret:%d\n", downstream_request_id, ret);
+		} else {
+			int ret = imquic_moq_reject_fetch(
+				downstream->conn, downstream_request_id,
+				IMQUIC_MOQ_REQERR_INTERNAL_ERROR,
+				"Publisher disconnected", 0, NULL);
+			IMQUIC_LOG(IMQUIC_LOG_INFO,
+				"interop_fetch_abort|phase:before-ok|request_id:%"SCNu64
+				"|ret:%d\n", downstream_request_id, ret);
+		}
+		g_hash_table_remove(
+			downstream->subscriptions_by_id, &downstream_request_id);
+	}
+	g_list_free(pending);
+}
