+static gboolean imquic_demo_interop_namespace_is(imquic_moq_namespace *tns,
+		const char *const *parts, size_t parts_num) {
+	size_t index = 0;
+	while(tns != NULL && index < parts_num) {
+		size_t len = strlen(parts[index]);
+		if(tns->length != len || memcmp(tns->buffer, parts[index], len))
+			return FALSE;
+		tns = tns->next;
+		index++;
+	}
+	return index == parts_num && tns == NULL;
+}
+
+static gboolean imquic_demo_interop_track_is(imquic_moq_track *tn,
+		const char *name) {
+	size_t length = strlen(name);
+	return tn != NULL && tn->length == length &&
+		!memcmp(tn->buffer, name, length);
+}
+
+static void imquic_demo_interop_publish(imquic_connection *conn,
+		const char *first, const char *second, const char *track_name,
+		gboolean finish_after_accept) {
+	imquic_moq_namespace ns[2] = { 0 };
+	ns[0].buffer = (uint8_t *)first;
+	ns[0].length = strlen(first);
+	if(second != NULL) {
+		ns[0].next = &ns[1];
+		ns[1].buffer = (uint8_t *)second;
+		ns[1].length = strlen(second);
+	}
+	imquic_moq_track track = {
+		.buffer = (uint8_t *)track_name,
+		.length = strlen(track_name),
+	};
+	imquic_moq_request_parameters params;
+	imquic_moq_request_parameters_init_defaults(&params);
+	params.forward_set = TRUE;
+	params.forward = TRUE;
+	uint64_t request_id = imquic_moq_get_next_request_id(conn);
+	if(imquic_moq_publish(conn, request_id, ns, &track, 0, &params, NULL) == 0) {
+		if(finish_after_accept)
+			interop_publish_done_id = request_id;
+		else
+			interop_publish_probe_id = request_id;
+	}
+}
