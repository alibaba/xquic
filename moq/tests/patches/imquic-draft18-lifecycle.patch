+static void imquic_demo_incoming_standalone_fetch(imquic_connection *conn,
+		uint64_t request_id, imquic_moq_namespace *tns, imquic_moq_track *tn,
+		imquic_moq_location_range *range,
+		imquic_moq_request_parameters *parameters) {
+	(void)parameters;
+	char tns_buffer[256], tn_buffer[256];
+	const char *ns = imquic_moq_namespace_str(tns, tns_buffer, sizeof(tns_buffer), TRUE);
+	const char *name = imquic_moq_track_str(tn, tn_buffer, sizeof(tn_buffer));
+	IMQUIC_LOG(IMQUIC_LOG_INFO,
+		"interop_fetch_responder|request_id:%"SCNu64"|track:%s/%s|range:%"SCNu64"/%"SCNu64"-%"SCNu64"/%"SCNu64"\n",
+		request_id, ns, name,
+		range ? range->start.group : 0, range ? range->start.object : 0,
+		range ? range->end.group : 0, range ? range->end.object : 0);
+	if(ns == NULL || name == NULL || strcasecmp(ns, pub_tns)
+			|| strcasecmp(name, pub_tn)) {
+		imquic_moq_reject_fetch(conn, request_id,
+			IMQUIC_MOQ_REQERR_DOES_NOT_EXIST, "Track not found", 0, NULL);
+		return;
+	}
+
+	imquic_moq_location largest = { .group = 4, .object = 0 };
+	imquic_moq_request_parameters response;
+	imquic_moq_request_parameters_init_defaults(&response);
+	response.group_order_set = TRUE;
+	response.group_order = IMQUIC_MOQ_ORDERING_ASCENDING;
+	int ret = imquic_moq_accept_fetch_with_end(
+		conn, request_id, TRUE, &largest, &response, NULL);
+	IMQUIC_LOG(IMQUIC_LOG_INFO,
+		"interop_fetch_responder|accepted|request_id:%"SCNu64"|end:4/0|ret:%d\n",
+		request_id, ret);
+	if(ret < 0)
+		return;
+
+	static const uint64_t groups[] = { 2, 2, 4 };
+	static const uint64_t subgroups[] = { 3, 3, 4 };
+	static const uint64_t objects[] = { 4, 5, 0 };
+	static const char payload_a[] = "imquic-fetch-A";
+	static const char payload_c[] = "imquic-fetch-C";
+	const uint8_t *payloads[] = {
+		(const uint8_t *)payload_a, NULL, (const uint8_t *)payload_c
+	};
+	const size_t payload_lengths[] = {
+		sizeof(payload_a) - 1, 0, sizeof(payload_c) - 1
+	};
+	imquic_moq_property property = { 0 };
+	property.id = 0x38;
+	property.value.number = sizeof(payload_a) - 1;
+	GList *properties = g_list_append(NULL, &property);
+	for(size_t i = 0; i < 3; i++) {
+		imquic_moq_object object = {
+			.request_id = request_id,
+			.group_id = groups[i],
+			.subgroup_id = subgroups[i],
+			.object_id = objects[i],
+			.object_status = IMQUIC_MOQ_NORMAL_OBJECT,
+			.priority = 7,
+			.properties = (i == 0 ? properties : NULL),
+			.payload = (uint8_t *)payloads[i],
+			.payload_len = payload_lengths[i],
+			.delivery = IMQUIC_MOQ_USE_FETCH,
+			.end_of_stream = (i == 2)
+		};
+		ret = imquic_moq_send_object(conn, &object);
+		IMQUIC_LOG(IMQUIC_LOG_INFO,
+			"interop_fetch_responder|object|index:%zu|group:%"SCNu64"|subgroup:%"SCNu64"|object:%"SCNu64"|payload:%zu|properties:%d|eos:%d|ret:%d\n",
+			i, object.group_id, object.subgroup_id, object.object_id,
+			object.payload_len, g_list_length(object.properties),
+			object.end_of_stream, ret);
+		if(ret < 0)
+			break;
+	}
+	g_list_free(properties);
+}
